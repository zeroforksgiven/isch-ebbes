---
const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, follow" />
    <title>{title} | Isch ebbes?</title>
  </head>
  <body>
    <header class="legal-header">
      <a class="brand" href="/">Isch ebbes?</a>
      <a class="home-link" href="/">Zur Startseite</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href="/">Isch ebbes?</a>
      <span> A-cappella-Vocal-Band des Sängerkranz 1863 e.V. Waibstadt</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(:root) {
    --ink: #000000;
    --ground: #1b1b1b;
    --panel: #272727;
    --text: #aca59a;
    --text-strong: #b8b2a7;
    --accent: #f5a15b;
    --accent-bright: #ffbf7d;
    --line: #484848;
  }

  :global(html) {
    background: var(--ground);
  }

  :global(body) {
    margin: 0;
    color: var(--text);
    font-family: system-ui, sans-serif;
    background: linear-gradient(180deg, var(--ground) 0%, #151515 100%);
    line-height: 1.7;
  }

  .legal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px max(24px, calc((100% - 960px) / 2));
    background: var(--ink);
  }

  .brand {
    color: var(--accent-bright);
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
  }

  .home-link {
    color: var(--text-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  main {
    width: min(100% - 48px, 820px);
    min-height: 70vh;
    margin: 0 auto;
    padding: 56px 0 72px;
  }

  footer {
    padding: 24px;
    background: var(--ink);
    color: var(--text);
    text-align: center;
    font-size: 0.9rem;
  }

  footer a {
    color: var(--accent-bright);
    font-weight: 700;
    text-decoration: none;
  }

  :global(h1) {
    margin: 0 0 24px;
    color: var(--text-strong);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.1;
  }

  :global(h2) {
    margin: 36px 0 10px;
    color: var(--text-strong);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  :global(p) {
    margin: 0 0 16px;
  }

  :global(a) {
    color: var(--accent-bright);
  }

  :global(.draft-note) {
    margin: 0 0 32px;
    padding: 16px 18px;
    border-left: 4px solid var(--accent);
    background: linear-gradient(145deg, #303030, var(--panel));
    color: var(--text-strong);
  }

  :global(.placeholder) {
    color: var(--accent-bright);
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .legal-header {
      padding: 16px 20px;
    }

    main {
      width: min(100% - 40px, 820px);
      padding: 40px 0 56px;
    }

    footer span {
      display: block;
      margin-top: 4px;
    }
  }
</style>